# Secrets
.env
.env.*
!.env.example

# Private real data — never commit (docs/09 §17)
private/
*_real*
.foresight-private/

# Statement files are ignored everywhere except generated and external eval fixtures
*.pdf
*.csv
*.xls
*.xlsx
!evals/datasets/**
!evals/external/datasets/**

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Local databases and caches
data/
*.db
*.db-wal
*.db-shm
evals/external/cache/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# OS / editors
.DS_Store
.idea/
.vscode/

# Next.js generated types
frontend/next-env.d.ts
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo

# Design-review captures stay local (CI keeps them as Playwright artifacts); the curated final
# set for the README lives in docs/screenshots/.
.design/foresight/screenshots/review-*
