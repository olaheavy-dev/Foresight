# Copy to .env (gitignored) and fill in. Never commit real values.

# Model provider: OpenAI (https://api.openai.com/v1; owner decision 20 Oct 2026, docs/00 §12 item
# 14), the only value accepted. backend/mesh is the only route; the MESH_* names below are kept
# from the gateway it called until 23 Oct 2026.
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
# Model IDs per tier (docs/06 §13). Blank means the default in backend/settings.py, shown here.
# Under openai every primary must be an openai/ model. The reasoning and verifier tiers have no
# fallback: the Advisor's model must never be its own judge.
MESH_MODEL_FAST=openai/gpt-6-luna
MESH_MODEL_FAST_FALLBACK=openai/gpt-6-sol
MESH_MODEL_REASONING=openai/gpt-6-sol
MESH_MODEL_REASONING_FALLBACK=
MESH_MODEL_VERIFIER=openai/gpt-6.1-sol
MESH_MODEL_VERIFIER_FALLBACK=
# live | record | replay (replay needs no key and never touches the network)
MESH_CASSETTE_MODE=live
# Cap on model spend per UTC day across every profile; AI answers pause once it is reached and
# resume the next day. 0 disables the cap.
MESH_DAILY_BUDGET_USD=0.50

# PostgreSQL 16
POSTGRES_USER=foresight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=foresight
DATABASE_URL=postgresql+psycopg://foresight:change_me@localhost:5432/foresight

# Signs the short-lived Google sign-in cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty → derived from the Google client secret.
SESSION_SECRET=
# Google sign-in (docs/05 §5.9). Leave empty to offer guest access only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# Keep true behind HTTPS; set false only for plain-http local testing outside localhost.
SESSION_COOKIE_SECURE=true

# Digest delivery (Stage 3)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The deployed commit is baked into the image as FORESIGHT_BUILD_SHA at build time.
# Never set it here: a runtime value would hide which build is actually running.

# Guests' daily AI allowance per network (backend/app/network_cap.py). Behind a CDN, say where
# the visitor's address is: a header only the edge sets (the origin must accept traffic from the
# edge alone), and/or the proxy ranges to skip in X-Forwarded-For.
GUEST_NETWORK_DAILY_QUESTIONS=20
GUEST_NETWORK_DAILY_CHECKS=3
CLIENT_IP_HEADER=
TRUSTED_PROXY_CIDRS=
