# Copy to .env (gitignored) and fill in. Never commit real values.

# Mesh API — the only route to any model (https://api.meshapi.ai/v1). Keys start with rsk_.
MESH_API_KEY=rsk_replace_me
# Model IDs come from Mesh's catalogue (docs/00 §12.1, docs/06 §13). These are the defaults.
MESH_MODEL_FAST=openai/gpt-6-luna
MESH_MODEL_FAST_FALLBACK=anthropic/claude-haiku-5.5
MESH_MODEL_REASONING=anthropic/claude-sonnet-5.5
MESH_MODEL_REASONING_FALLBACK=google/gemini-3.1-pro
MESH_MODEL_VERIFIER=openai/gpt-6.1-sol
MESH_MODEL_VERIFIER_FALLBACK=google/gemini-3.1-pro
# live | record | replay (replay needs no key and never touches the network)
MESH_CASSETTE_MODE=live
# Cap on model spend per UTC day across every profile; AI answers pause once it is reached and
# resume the next day. 0 disables the cap.
MESH_DAILY_BUDGET_USD=0.50

# PostgreSQL 16
POSTGRES_USER=foresight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=foresight
DATABASE_URL=postgresql+psycopg://foresight:change_me@localhost:5432/foresight

# Signs the profile cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty → a random secret per API process (profiles are forgotten on restart).
SESSION_SECRET=
# Keep true behind HTTPS; set false only for plain-http local testing outside localhost.
SESSION_COOKIE_SECURE=true

# Digest delivery (Stage 3)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The deployed commit is baked into the image as FORESIGHT_BUILD_SHA at build time.
# Never set it here: a runtime value would hide which build is actually running.
