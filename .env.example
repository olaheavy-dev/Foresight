# Copy to .env (gitignored) and fill in. Never commit real values.

# Mesh API — the only route to any model (https://api.meshapi.ai/v1). Keys start with rsk_.
MESH_API_KEY=rsk_replace_me
# Model IDs come from Mesh's catalogue (docs/00 §12.1); leave empty until chosen.
MESH_MODEL_FAST=
MESH_MODEL_FAST_FALLBACK=
MESH_MODEL_REASONING=
MESH_MODEL_REASONING_FALLBACK=

# PostgreSQL 16
POSTGRES_USER=foresight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=foresight
DATABASE_URL=postgresql+psycopg://foresight:change_me@localhost:5432/foresight

# Digest delivery (Stage 3)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Set by the deploy pipeline; shown at /healthz
DEPLOY_SHA=local
